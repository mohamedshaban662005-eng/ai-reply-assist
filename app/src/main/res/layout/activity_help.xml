<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/help_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Card -->
        <LinearLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_help_header"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_help_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_title"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_help_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/help_subtitle"
                android:textColor="#E0E7FF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Section 1: Setup & API Key -->
        <LinearLayout
            android:id="@+id/card_section_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_help_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_sec1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_sec1_title"
                android:textColor="@color/brand_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sec1_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/help_sec1_body"
                android:textColor="@color/brand_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Section 2: Notification Interception -->
        <LinearLayout
            android:id="@+id/card_section_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_help_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_sec2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_sec2_title"
                android:textColor="@color/brand_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sec2_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/help_sec2_body"
                android:textColor="@color/brand_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Section 3: Blacklist Filtering -->
        <LinearLayout
            android:id="@+id/card_section_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_help_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_sec3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_sec3_title"
                android:textColor="@color/brand_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sec3_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/help_sec3_body"
                android:textColor="@color/brand_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Section 4: Battery Optimization -->
        <LinearLayout
            android:id="@+id/card_section_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_help_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_sec4_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_sec4_title"
                android:textColor="@color/brand_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sec4_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/help_sec4_body"
                android:textColor="@color/brand_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Section 5: AI Personas -->
        <LinearLayout
            android:id="@+id/card_section_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_help_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_sec5_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_sec5_title"
                android:textColor="@color/brand_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sec5_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/help_sec5_body"
                android:textColor="@color/brand_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Return / Close Button -->
        <Button
            android:id="@+id/btn_close_help"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_help_button"
            android:text="@string/help_btn_close"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
