<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Card -->
        <LinearLayout
            android:id="@+id/settings_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_help_header"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_settings_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_activity_title"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_settings_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_auth_title"
                android:textColor="#E0E7FF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Language Switch Section Card -->
        <LinearLayout
            android:id="@+id/card_language_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_help_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_language_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_section_title"
                android:textColor="@color/brand_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_current_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/brand_text_secondary"
                android:textSize="14sp" />

            <!-- LanguageSwitchButton: Required UI Component -->
            <Button
                android:id="@+id/LanguageSwitchButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_help_button"
                android:text="@string/btn_switch_language"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Google AI Studio & Security Card -->
        <LinearLayout
            android:id="@+id/card_settings_auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_help_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_auth_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_auth_title"
                android:textColor="@color/brand_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_auth_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_crypto_note"
                android:textColor="@color/brand_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Battery & Background Card -->
        <LinearLayout
            android:id="@+id/card_settings_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_help_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_battery_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/battery_section_title"
                android:textColor="@color/brand_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_battery_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/battery_unrestricted_desc"
                android:textColor="@color/brand_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Return / Close Button -->
        <Button
            android:id="@+id/btn_close_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_help_button"
            android:text="@string/help_btn_close"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
